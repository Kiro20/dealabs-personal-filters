{
  "manifest_version": 3,
  "name": "Filtres personnels pour Dealabs",
  "version": "1.5.0",
  "description": "Extension non officielle pour filtrer localement tous les deals par titre et boutique.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "dealabs-personal-filters@kiro20.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "content_scripts": [{
    "matches": ["https://www.dealabs.com/tous"],
    "js": ["filters.js", "content.js"],
    "run_at": "document_idle"
  }]
}
